{
  "name": "base-api",
  "version": "1.0.3",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.11",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  },
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "tsnd --respawn --transpile-only --exit-child -r tsconfig-paths/register src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/redis": "^7.0.2",
    "@prisma/client": "6.5.0",
    "@vercel/node": "^5.1.14",
    "fastify": "^5.2.1",
    "fastify-blipp": "^4.0.0",
    "fastify-zod": "^1.4.0",
    "ioredis": "^5.6.0",
    "minio": "^8.0.5",
    "prisma": "6.5.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "standart": {
    "ignore": [
      "**/node_modules/**/*"
    ]
  }
}